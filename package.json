{
  "name": "expressive-assets",
  "version": "0.1.0",
  "private": true,
  "description": "Expressive Assets \u2014 the icon and illustration library for Windows Design Systems.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "node scripts/generate-assets.mjs",
    "figma:survey": "node scripts/import-figma.mjs --survey",
    "figma:plan": "node scripts/import-figma.mjs --dry-run",
    "figma:import": "node scripts/import-figma.mjs",
    "notices": "node scripts/build-notices.mjs",
    "manifest": "node scripts/build-manifest.mjs",
    "validate": "node scripts/validate.mjs",
    "build": "npm run notices && npm run manifest && npm run validate && node scripts/build-site.mjs",
    "dev": "node scripts/build-site.mjs && node scripts/serve.mjs",
    "figma:run": "node scripts/import-figma.mjs --plan=figma-plan.json",
    "figma:run:product": "node scripts/import-figma.mjs --plan=figma-product-plan.json",
    "figma:run:m365": "node scripts/import-figma.mjs --plan=figma-m365-plan.json",
    "test:plugin": "node plugin/test-sync.mjs",
    "figma:plan:3p": "node scripts/build-3p-plan.mjs",
    "figma:run:3p": "node scripts/import-figma.mjs --plan=figma-3p-plan.json"
  }
}
